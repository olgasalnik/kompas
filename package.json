{
  "name": "kompas",
  "private": true,
  "version": "0.1.0",
  "description": "Компас — цифровой ассистент врача и пациента для ведения тревожно-депрессивных состояний (прототип, синтетические данные)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "build:share": "npm run build:offline && node scripts/make-share.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "shots": "node scripts/shots.mjs",
    "check:recognition": "node scripts/check-recognition.mjs",
    "summary": "node scripts/summary-pdf.mjs",
    "story": "node scripts/story-pdf.mjs",
    "story:images": "node scripts/story-images.mjs",
    "qr": "node scripts/qr.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.2.5",
    "@fontsource/manrope": "5.2.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "lucide-react": "0.460.0",
    "qrcode.react": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
